# fitnaai environment configuration
# Copy to .env and adjust values

# Debug mode (enables auto-reload)
FITNAAI_DEBUG=false

# API server bind
FITNAAI_HOST=0.0.0.0
FITNAAI_PORT=8000

# Ollama backend (Host 2 / pve-ryzen with GTX 1080)
FITNAAI_OLLAMA_BASE_URL=http://192.168.16.3:11434
FITNAAI_OLLAMA_MODEL=llama3.2

# Data directory (mounted volume)
FITNAAI_DATA_DIR=/data
