# JBOT Production Environment Variables
# Copy to .env and fill in real values:  cp .env.example .env

# PostgreSQL
POSTGRES_PASSWORD=changeme_generate_a_secure_password

# Traefik ACME (Let's Encrypt)
ACME_EMAIL=admin@yourdomain.com

# JBOT API image (override default)
# JBOT_API_IMAGE=yourorg/jbot-api:latest
